# ============================
# z-mq 本地存储（运行时生成的 1GB MappedFile，绝不入仓）
# ============================
z-mq/**/~/
**/store/
# 上面那条是给 z-mq 运行时 MappedFile 加的, 但它顺带吞掉了前端人写的
# src/zteam/pages/workspace/store/(11 个 .ts), 换机器 clone 就少一份源码
!bootstraps/z-opc-main-starter-frontend/src/zteam/pages/workspace/store/
**/storePath/
**/commitlog/

# git filter-repo 备份
.git-rewrite/

# swap files
*.swp
*.swo

# OS
.DS_Store



# 个人 TODO 及其他私人内容
_personal/

# 另一个 Hermes agent workspace(避免与 .hermes/ 冲突)
_hermes/

# Python 编译缓存
__pycache__/
*.pyc
*.pyo
*.pyd

# 测试覆盖率产物（vitest / jest）
coverage/

