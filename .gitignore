# ============================
# Maven
# ============================
target/
# 根目录不应有 META-INF (避免在根目录跑 mvn package 误生成)
/META-INF/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ============================
# Java
# ============================
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar
*.flattened-pom.xml
.flattened-pom.xml
*.lst

# ============================
# IDE
# ============================
## IntelliJ IDEA ##
.idea/
*.iws
*.iml
*.ipr
.idea/modules.xml
.idea/jarRepositories.xml
.idea/compiler.xml
.idea/libraries/
out/

## Eclipse ##
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
bin/
# 上面那条 bin/ 是 Eclipse 的输出约定, 但 z-opc 根 bin/ 是人写的运维脚本,
# 而 z-team-indexer 的 src/**/resources/bin/ 是运行时释放的索引器资源
# (IndexBuildService.java:54/:240 从 classpath 读), 两者必须随 clone 走
!/bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

## NetBeans ##
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

## VS Code ##
.vscode/

