<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-surl</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>z-surl-starter</artifactId>
    <version>${revision}</version>
    <packaging>jar</packaging>

    <!--
        业务方 import 的**唯一入口**（→ Maven Central）。按 005 规范 §2.5，starter 自带的 web 层
        （Controller + DTO）也算 starter 的一部分，同样要发 Central。
    -->
    <name>z-surl-starter</name>
    <description>z-surl starter 模块：Spring Boot 自动装配（独立数据源 + SqlSessionFactory）+ 短链 HTTP API（管理面 /api/zSurl/** + 跳转面 /s/{mapKey}）</description>
    <url>https://github.com/z-opc-foundation/z-surl</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-opc-foundation</organization>
            <organizationUrl>https://github.com/z-opc-foundation</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/z-opc-foundation/z-surl.git</connection>
        <developerConnection>scm:git:ssh://git@github.com:z-opc-foundation/z-surl.git</developerConnection>
        <url>https://github.com/z-opc-foundation/z-surl</url>
        <tag>HEAD</tag>
    </scm>

    <dependencies>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-surl-core</artifactId>
        </dependency>

        <!-- L2 聚合 starter，版本在根 dependencyManagement 锁定，子模块不写 version -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-boot-web-starter</artifactId>
        </dependency>
        <!-- ModuleDataSourceTemplate：短链走自己的独立数据源，不复用其他模块的 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-boot-datasource-starter</artifactId>
        </dependency>
        <!-- Result / ResultCode 统一响应包装 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-core</artifactId>
        </dependency>

        <!-- MybatisPlusInterceptor / PaginationInnerInterceptor / MybatisSqlSessionFactoryBean -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-extension</artifactId>
        </dependency>
        <!-- @MapperScan / FullyQualifiedAnnotationBeanNameGenerator -->
        <dependency>
            <groupId>org.mybatis</groupId>
            <artifactId>mybatis-spring</artifactId>
        </dependency>
        <!-- @AutoConfiguration / @ConditionalOnMissingBean -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- javax.validation.constraints（@NotBlank / @Size） -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
