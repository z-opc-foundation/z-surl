{
  "name": "@yuku123/z-surl-component",
  "version": "1.0.0",
  "description": "z-surl 短链控制台组件层（跨仓复用；纯展示 + props 契约，不直接 fetch）",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pages": {
      "types": "./dist/pages.d.ts",
      "import": "./dist/pages.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/verify-dist.mjs",
    "dev": "vite build --watch"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "peerDependencies": {
    "antd": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "antd": "^6.3.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.6.3",
    "vite": "^6.2.0"
  }
}
