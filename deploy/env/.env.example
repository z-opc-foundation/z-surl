# ============================================================================
# z-surl 部署参数（**模板**）—— 复制成 env/.env 再改
#
#     cp env/.env.example env/.env
#
# env/.env 已被 .gitignore 排除，凭证永不入 Git
# （008_组织规范/001_凭证管理规范.md）。
# compose 会自动读取同目录（deploy/）下的 .env，本文件里的 ${VAR} 靠它替换。
# ============================================================================

# ---- 镜像 ----
# 组织中心镜像仓库（192.168.31.250:5000，见 007 发布链 §4.2）
# 本地构建验证可留空，默认用 zifang
IMAGE_REPO=zifang

# 版本号。必须与仓内 pom 的 <revision> 一致 —— Dockerfile 按
# z-surl-admin-${VERSION}-exec.jar 取产物，两边不一致就是 "COPY failed: no such file"
VERSION=1.0.0

# ---- 端口 ----
# Mode 1：合体，单容器（默认 8080）
ZSURL_HTTP_PORT=8080
# Mode 2/3：前端 nginx 入口（默认 8088，避开 Mode 1 的 8080）
# ZSURL_HTTP_PORT=8088
# Mode 2：后端直连端口
ZSURL_BACKEND_PORT=8081

# ---- Spring profile ----
# prod = 走 z.base.db.surl.* 连真实 MySQL
# dev  = H2 内存库，容器重启即丢数据，**禁止**用于生产
ZSURL_PROFILE=prod

# ---- 数据源（z-base-datasource-starter 的 ModuleDataSourceTemplate 只认这 5 个键）----
# 注意：它自己拼 jdbc:mysql://{host}:{port}/{database}?serverTimezone=UTC&...
#      所以这里**没有 url 选项**，写了也不生效。
# host.docker.internal = 从容器访问宿主机；MySQL 也在 compose 里就填服务名（如 mysql）
ZSURL_DB_HOST=host.docker.internal
ZSURL_DB_PORT=3306
ZSURL_DB_NAME=oc
ZSURL_DB_USER=root

# 留空会连不上（这是有意的：空密码连失败比拿猜的密码反复试好）
ZSURL_DB_PASSWORD=

# ---- JVM ----
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+UseSerialGC

TZ=Asia/Shanghai
