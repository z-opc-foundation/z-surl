# ============================================================================
# z-surl 前端 nginx（Mode 2 分体 / Mode 3 集群用）
#
# 由 nginx 官方镜像的 envsubst 机制渲染：/etc/nginx/templates/default.conf.template
#   → /etc/nginx/conf.d/default.conf
#
# 必填变量：${ZSURL_BACKEND_UPSTREAM}
#   一整段 upstream server 声明，由 compose/k8s 注入，Mode 2/3 共用本模板：
#     Mode 2（单后端）：  "server backend:8080;"
#     Mode 3（三后端）：  "server backend-0:8080; server backend-1:8080; server backend-2:8080;"
#
# 【为什么把 upstream 整段交给环境变量，而不是在模板里写死 server ${BACKEND_SERVICE}:...]
# 写死单条 server 的话，Mode 3 就不可能做负载均衡 —— nginx 只会取 DNS 的第一条 A 记录。
# 而"用 socat 之类的转发器假装负载均衡"更糟：socat TCP-LISTEN 转发到的是**固定**目标，
# 不是 round-robin，看着有 3 个后端，实际全打在 backend-0。所以这里让编排层
# 显式给出多行 server，交给 nginx 自己做 round-robin。
#
# 【SPA 路由必须配 try_files】
# 控制台是 SPA，刷新页面时浏览器会直接请求深链路。没有 `try_files ... /index.html`
# 的话，nginx 会去磁盘找该文件，找不到就 404 —— 表现为"开发时 vite dev 好好的，
# 一部署就白屏"。这是前端 SPA 最经典的一个部署坑。
# ============================================================================

upstream z_surl_backend {
    ${ZSURL_BACKEND_UPSTREAM}
    keepalive 32;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # 静态资源：文件名带内容 hash，可长期缓存
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA 入口回退
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }

    # 管理面反代
    location /api/ {
        proxy_pass http://z_surl_backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
        proxy_read_timeout 30s;
    }

    # 短链跳转面。
    # **必须用 proxy_pass 而不是 return 302**：短链要 302 + Location 指向目标站，
    # 且命中计数是在后端 resolve() 里 +1 的 —— nginx 直接 302 会绕过计数，
    # 表现为"短链能跳但命中数永远是 0"。
    location /s/ {
        proxy_pass http://z_surl_backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 跳转是 302，禁缓存：短链失效后浏览器/CDN 不该继续用旧 Location
        add_header Cache-Control "no-store";
    }

    # 健康检查（compose/k8s 探针打这个，不用经过 Spring）
    location = /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }
}
